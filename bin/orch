#!/usr/bin/env python3
"""orch — Orca + any-agent orchestration harness.

Thin but opinionated wrapper over the `orca` CLI. Encodes the measured
failure-mode fixes so a coordinator agent (human-driven or an agent)
never re-derives them. Agent-specific knowledge (launch argv, bypass
flags, ready/approval/rate-limit screen signatures, model tiers, where
transcripts live) is DATA in adapters/<id>.json — see `orch agents`.

Model specifier everywhere: `[<agent>:]<tier|model>` — tier is
medium|high|max, e.g. `claude:high`, `codex:medium`, `swe-2-high`
(a known model id picks its agent). Default agent: --agent > ORCH_AGENT
> run state (`orch boot --agent`) > devin.

  spawn    worker = new worktree + adapter-built agent terminal (bypass
           flags always on) + supervised dispatch (worker-start --terminal).
           Any failure after worktree create rolls the worktree/branch/
           terminal back — no stale wreckage from `worker-start failed`
  batch    serial spawn loop from a JSON manifest (task→name/model map is
           DATA, not a shell `declare -A`). Paced spawns + per-item retry;
           one bad item doesn't kill the batch
  wait     event-driven `check --wait --types ...` + ack chaining
           (never sleep-polls; heartbeats can't spuriously wake it)
  score    Jev (TypeSafe System One) pre-screen: score each candidate
           against its spec so the coordinator reviews the top few,
           not every worktree. Requires TYPESAFE_API_KEY
  --jev    flag on spawn/compete/batch/patrol/adopt adds cheap semantic
           checks (spec-ambiguity gate, stuck-terminal detection,
           done-claim sanity) — advisory except the medium-on-ambiguous
           spec block
  patrol   sweeps live dispatches: approval-menu stalls, startup gates,
           rate limits (auto-lowers that provider's cap), silent workers
  collect  settle report: dispatch -> outcome / branch / worktree
  adopt    record which candidate won a competition
  integrate spawn an integrator worker that merges adopted branches
  clean    worker-release + worktree rm + terminal close
           (--losers = only candidates that verifiably lost a decided
           competition; live integrators/undecided candidates never match)
  boot     spawn a coordinator terminal running playbooks/coordinator.md
  task     task-create wrapper (deps-aware)
  status   dashboard of run/tasks/dispatches/per-provider caps
  agents   list adapters: binary found?, provider, tiers, live sessions
  hooks    `hooks install --agent X [--apply]` — persistent hook install
  weights  spawn-time weight estimates vs actual worker metrics
           (.orch/estimates.jsonl, reviewable later)
  estimate preview weight estimates for a manifest or spec files
           (heaviest-first — the order that minimizes makespan)

Local state (dispatch -> worktree/branch/terminal) lives in
`.orch/state.json` in the current directory, events in
`.orch/events.jsonl`. Add `.orch/` to .gitignore.

Requires: orca CLI on PATH (or $ORCA_CLI_COMMAND), the agent CLIs you
use. Python 3.9+, stdlib only.
"""
import collections
import json
import os
import re
import sqlite3
import subprocess
import sys
import time
import urllib.request

HARNESS_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(HARNESS_DIR, "lib"))
from orchlib import adapters as A  # noqa: E402
from orchlib import events  # noqa: E402

ORCA = os.environ.get("ORCA_CLI_COMMAND", "orca")
STATE_DIR = ".orch"
STATE_FILE = os.path.join(STATE_DIR, "state.json")


# ---------- low-level ----------

def die(msg, code=1):
    sys.stderr.write(f"orch: {msg}\n")
    sys.exit(code)


def orca(*args, check=True, timeout=None):
    """Run `orca <args> --json`, return parsed .result (or whole doc)."""
    cmd = [ORCA, *args, "--json"]
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        die(f"timeout: {' '.join(cmd)}")
    if p.returncode != 0:
        if check:
            die(f"`{' '.join(cmd)}` failed:\n{p.stderr or p.stdout}")
        return None
    try:
        doc = json.loads(p.stdout)
    except json.JSONDecodeError:
        if check:
            die(f"bad json from `{' '.join(cmd)}`:\n{p.stdout[:400]}")
        return None
    if isinstance(doc, dict) and doc.get("ok") is False and check:
        die(f"orca error: {json.dumps(doc)[:600]}")
    return doc.get("result", doc) if isinstance(doc, dict) else doc


def dig(obj, *keys, default=None):
    """Tolerant nested lookup: dig(x, 'a','b') finds first x['a']['b'],
    also tries obj['result'] prefix and any nested dict containing the key."""
    for k in keys:
        if isinstance(obj, dict) and k in obj:
            obj = obj[k]
        else:
            return default
    return obj


def find_key(obj, key, default=None):
    """BFS for first occurrence of `key` in nested dict/list."""
    q = [obj]
    while q:
        o = q.pop(0)
        if isinstance(o, dict):
            if key in o:
                return o[key]
            q.extend(o.values())
        elif isinstance(o, list):
            q.extend(o)
    return default


# ---------- state ----------

def state_load():
    try:
        with open(STATE_FILE) as f:
            return json.load(f)
    except Exception:
        return {"runs": {}}


def state_save(st):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(st, f, ensure_ascii=False, indent=1)
    os.replace(tmp, STATE_FILE)


def cur_run(st):
    rid = st.get("current_run")
    if not rid or rid not in st["runs"]:
        die("no current run (state file has none). Run `orch run create` first.")
    return rid, st["runs"][rid]


# ---------- commands ----------

def cmd_init(args):
    """Register cwd repo with Orca (idempotent) + prepare .orch/."""
    path = os.path.abspath(args.get("--repo") or os.getcwd())
    repos = find_key(orca("repo", "list"), "repos", []) or []
    hit = next((r for r in repos if r.get("path") == path), None)
    if hit:
        print(f"repo already registered: {hit['id']} ({hit.get('displayName')})")
    else:
        r = orca("repo", "add", "--path", path)
        print(f"repo added: {json.dumps(r)[:300]}")
    os.makedirs(STATE_DIR, exist_ok=True)
    gi = os.path.join(path, ".gitignore")
    try:
        cur = open(gi).read()
    except FileNotFoundError:
        cur = ""
    if ".orch/" not in cur:
        with open(gi, "a") as f:
            f.write(("\n" if cur and not cur.endswith("\n") else "") + ".orch/\n")
        print(".gitignore += .orch/")


def cmd_run_create(args):
    obj = " ".join(args["_"])
    if not obj:
        die("usage: orch run create <objective>")
    r = orca("orchestration", "run-create", "--objective", obj)
    rid = find_key(r, "id") or find_key(r, "runId")
    st = state_load()
    st["runs"][rid] = {"objective": obj, "created_at": int(time.time()),
                     "tasks": {}, "dispatches": {}}
    st["current_run"] = rid
    state_save(st)
    print(json.dumps({"run": rid}, indent=1))


def cmd_task_create(args):
    files = args["_"]
    if not files:
        die("usage: orch task create <spec-file>... [--deps a,b] [--cluster C] "
            "[--agent A]  (--agent appends that agent's spec notes)")
    deps = json.dumps([d for d in (args.get("--deps") or "").split(",") if d])
    st = state_load()
    rid, run = cur_run(st)
    out = []
    for f in files:
        spec = open(f).read()
        if args.get("--agent"):
            spec = _spec_for_agent(spec, args["--agent"])
        title = args.get("--title") or os.path.splitext(os.path.basename(f))[0]
        r = orca("orchestration", "task-create", "--spec", spec,
                 "--task-title", title, "--deps", deps, "--run", rid)
        tid = find_key(r, "id") or find_key(r, "taskId")
        run["tasks"][tid] = {"title": title, "spec_file": f,
                             "cluster": args.get("--cluster"),
                             "deps": json.loads(deps), "dispatches": []}
        out.append({"task": tid, "title": title})
    state_save(st)
    print(json.dumps(out, indent=1))


def _screen_tail(handle, n=40):
    t = orca("terminal", "read", "--terminal", handle, "--screen",
             check=False)
    tail = find_key(t, "tail", []) or []
    return "\n".join(tail[-n:])


def _send_keys(handle, keys):
    for k in keys:
        if k == "enter":
            orca("terminal", "send", "--terminal", handle, "--enter",
                 check=False)
        else:
            orca("terminal", "send", "--terminal", handle, "--text", k,
                 check=False)
        time.sleep(0.5)


def _wait_ready(handle, a):
    """Wait until the agent TUI can accept injected input.

    Injecting early makes worker-start stall at dispatch_input
    (agent_prompt_stalled: prompt pasted but Enter never submitted —
    measured on devin). Strategy comes from the adapter:
      screen-regex  poll the screen for adapter.screen.ready
      orca-tui-idle Orca's own readiness (`terminal wait --for tui-idle`)
                    — only trustworthy for agents Orca has rules/hooks for
      both          tui-idle first, then confirm with the regex
    While waiting, startup gates (workspace trust, bypass confirmation,
    upgrade notices) are answered with the adapter's keys — a trust gate
    stalled a claude worker before its first turn in the month log."""
    rd = a.get("readiness") or {}
    strategy = rd.get("strategy") or "screen-regex"
    deadline = time.time() + float(rd.get("timeout_s") or 180)
    if strategy in ("orca-tui-idle", "both") or not A.screen_rx(a, "ready"):
        orca("terminal", "wait", "--terminal", handle, "--for", "tui-idle",
             "--timeout-ms", str(int(max(5, deadline - time.time()) * 1000)),
             check=False, timeout=deadline - time.time() + 30)
        if strategy == "orca-tui-idle" or not A.screen_rx(a, "ready"):
            tail = _screen_tail(handle)
            keys = A.startup_prompt(a, tail)
            if keys:
                _send_keys(handle, keys)
            return True
    answered = 0
    while time.time() < deadline:
        tail = _screen_tail(handle)
        keys = A.startup_prompt(a, tail)
        if keys and answered < 4:
            _send_keys(handle, keys)
            answered += 1
            time.sleep(2)
            continue
        if A.screen_match(a, "ready", tail):
            return True
        time.sleep(2)
    return False


def _submit_pending_paste(handle, a):
    """If a '[Pasted text ...]' blob sits unsubmitted in the input, send Enter."""
    if A.screen_match(a, "pending_paste", _screen_tail(handle)):
        orca("terminal", "send", "--terminal", handle, "--enter", check=False)
        time.sleep(2)


def _send_prompt(handle, prompt, a, retries=3):
    """Send prompt into the agent TUI and verify it actually left the
    input box (adapter.screen.input_echo: unsubmitted input rendered
    after the prompt marker, e.g. devin's '❭'; a sent message clears it).
    Retries cover the 'prompt pasted but Enter never submitted' stall
    that bypass flags cannot prevent (TUI timing, not a permission menu).
    Adapters without an input_echo rule can't be verified: one send +
    paste rescue, reported as submitted."""
    first = prompt.splitlines()[0][:30]
    for _ in range(retries):
        orca("terminal", "send", "--terminal", handle, "--text", prompt,
             "--enter", check=False)
        time.sleep(3)
        _submit_pending_paste(handle, a)
        if not A.screen_rx(a, "input_echo", first):
            return True
        deadline = time.time() + 45
        while time.time() < deadline:
            if not A.screen_match(a, "input_echo", _screen_tail(handle),
                                  first):
                return True
            time.sleep(2)
    return False


# ---------- parallel cap (per-provider rate limits) ----------
#
# Measured incident (2026-09-18): a 30-worker batch had every session —
# high AND max — die at once with "Reached free model rate limit" after
# ~35 min at 19-24 concurrent generations; <=4 concurrent never trips it.
# Month log: 56 devin processes hit it in two days and a human typed 95
# resume prompts. Quotas are per PROVIDER account, so the enforceable
# proxy is the live session count of every agent CLI of that provider
# across the WHOLE machine (interactive sessions and other runs included),
# not just this run's dispatches — and each provider gets its own cap.

DEVIN_DB = os.path.expanduser(
    os.environ.get("ORCH_DEVIN_DB", "~/.local/share/devin/cli/sessions.db"))
LOCK_DIR = os.path.expanduser("~/.local/share/devin/cli/session_locks")
DEFAULT_PARALLEL_CAP = 10
DEFAULT_IDLE_MIN = 15


def _idle_min():
    try:
        return int(os.environ.get("ORCH_PARALLEL_IDLE_MIN",
                                  DEFAULT_IDLE_MIN))
    except ValueError:
        return DEFAULT_IDLE_MIN


def _ro_db(path):
    return sqlite3.connect(f"file:{path}?mode=ro&immutable=1", uri=True)


def _devin_lock_slugs():
    """Lock files whose PID is alive AND is the devin binary. Stale lock
    files persist after exit and PIDs get recycled — both are filtered by
    the comm check."""
    import glob
    slugs = []
    for path in glob.glob(os.path.join(LOCK_DIR, "*.lock")):
        try:
            pid = int(open(path).read().strip())
            comm = subprocess.run(
                ["ps", "-p", str(pid), "-o", "comm="],
                capture_output=True, text=True, timeout=3).stdout.strip()
            if os.path.basename(comm) == "devin":
                slugs.append(os.path.basename(path)[:-5])
        except Exception:
            continue
    return slugs


def _live_devin(active_only=True):
    """devin sessions; active_only keeps those whose last_activity_at
    (sessions.db) is within ORCH_PARALLEL_IDLE_MIN minutes (default 15;
    0 = count every live process). Sessions missing from sessions.db are
    counted (unknown = conservative) — days-idle leftovers don't eat slots."""
    slugs = _devin_lock_slugs()
    idle = _idle_min()
    if not active_only or idle <= 0 or not slugs:
        return len(slugs)
    cutoff = time.time() - idle * 60
    act = {}
    try:
        for sid, la in _ro_db(DEVIN_DB).execute(
                "SELECT id, last_activity_at FROM sessions"):
            act[sid] = la or 0
    except Exception:
        return len(slugs)   # can't measure activity -> count all live
    return sum(1 for s in slugs if s not in act or act[s] >= cutoff)


_PS_CACHE = None


def _ps_comms():
    global _PS_CACHE
    if _PS_CACHE is None:
        try:
            out = subprocess.run(["ps", "-axo", "comm="], capture_output=True,
                                 text=True, timeout=5).stdout
            _PS_CACHE = [os.path.basename(x.strip())
                         for x in out.splitlines() if x.strip()]
        except Exception:
            _PS_CACHE = []
    return _PS_CACHE


def _live_count(a, active_only=True):
    """Live sessions of one adapter's CLI. `devin_locks` has an activity
    filter; `ps` counts processes by name (no idle filter — the CLIs
    don't expose last-activity cheaply; idle leftovers count)."""
    lv = a.get("liveness") or "ps"
    if lv == "devin_locks":
        return _live_devin(active_only)
    if lv == "ps":
        names = set(a.get("process_names") or [])
        n = sum(1 for c in _ps_comms() if c in names)
        idle = _idle_min()
        if not active_only or idle <= 0 or not n or \
                not a.get("activity_globs"):
            return n
        # same lesson as devin: interactive sessions left open for days
        # must not eat the quota slots. A live process is "active" only
        # if some transcript file of that CLI was written within the idle
        # window — min(processes, recently-written transcripts). A single
        # shared DB (opencode) can only say "something is active".
        import glob
        cutoff = time.time() - idle * 60
        recent = 0
        for g in a["activity_globs"]:
            for f in glob.glob(os.path.expanduser(g)):
                try:
                    if os.path.getmtime(f) >= cutoff:
                        recent += 1
                except OSError:
                    continue
        return min(n, recent)
    return 0


def _live_by_provider(active_only=True):
    out = collections.Counter()
    for aid in A.list_ids():
        try:
            a = A.load(aid)
        except A.AdapterError:
            continue
        out[a["provider"]] += _live_count(a, active_only)
    return out


def _parallel_cap(st, provider=None):
    """ORCH_PARALLEL_CAP_<PROVIDER> env > run['caps'][provider] (persisted
    by `orch boot --cap provider=N` or lowered by patrol on a rate limit)
    > ORCH_PARALLEL_CAP env > run['parallel_cap'] (`orch boot --cap N`)
    > default. 0 disables."""
    run = (st.get("runs") or {}).get(st.get("current_run") or "", {})
    cands = []
    if provider:
        cands += [os.environ.get(f"ORCH_PARALLEL_CAP_{provider.upper()}"),
                  (run.get("caps") or {}).get(provider)]
    cands += [os.environ.get("ORCH_PARALLEL_CAP"), run.get("parallel_cap")]
    base = DEFAULT_PARALLEL_CAP
    for v in cands:
        if v is None or v == "":
            continue
        try:
            base = int(v)
            break
        except (TypeError, ValueError):
            continue
    # a cap lowered by patrol after a rate limit is a ceiling over every
    # configured source — otherwise an env cap would silently undo it
    auto = (run.get("caps_auto") or {}).get(provider) if provider else None
    if auto:
        return min(base, auto) if base > 0 else auto
    return base


class ParallelCapReached(Exception):
    pass


def _check_parallel_cap(st, need=None):
    """need: {provider: n new sessions}."""
    if not need:
        need = {A.load(A.default_agent(None, (st.get("runs") or {}).get(
            st.get("current_run") or "", {})))["provider"]: 1}
    live = None
    for prov, n in need.items():
        cap = _parallel_cap(st, prov)
        if cap <= 0:
            continue
        if live is None:
            live = _live_by_provider()
        if live[prov] + n > cap:
            raise ParallelCapReached(
                f"parallel cap ({prov}): {live[prov]} active sessions + {n} "
                f"new > cap {cap}. Rate limits are per provider account — "
                "the 2026-09-18 incident killed all 30 concurrent workers at "
                "once. Free slots with `orch collect` + `orch clean`, shrink "
                "the request, spread across agents of other providers, or "
                f"raise the cap via `orch boot --cap {prov}=N` / "
                f"ORCH_PARALLEL_CAP_{prov.upper()} env (0 = off)")


# ---------- task weight estimation ----------
#
# Every dispatched worker's first prompt embeds its orca task id, so an
# agent transcript joins to orchestration.db tasks.spec (lib/orchlib/
# metrics.py has one reader per agent). From the join we get per-(agent,
# model, spec-length) medians of input/output tokens and generation time.
# Agents without a transcript reader still get durations from orch's own
# event log (spawn -> worker_done). Estimates are recorded to
# .orch/estimates.jsonl at spawn time so the user can review "predicted
# vs actual" later via `orch weights`.

ORCA_DB = os.path.expanduser(
    "~/Library/Application Support/orca/orchestration.db")
SPEC_BUCKETS = (2000, 6000)
ESTIMATES_FILE = os.path.join(STATE_DIR, "estimates.jsonl")


def _spec_len(task_id):
    try:
        r = _ro_db(ORCA_DB).execute(
            "SELECT length(spec) FROM tasks WHERE id=?",
            (task_id,)).fetchone()
        return r[0] if r else 0
    except Exception:
        return 0


def _norm_model(agent, model):
    """Transcript model ids are long ('claude-opus-5-5'); adapters use
    short ones ('opus'). Map to the adapter's tier model when one is a
    substring so history and spawn-time lookups share a key."""
    if not model or not agent:
        return model
    try:
        tiers = A.load(agent)["models"]["tiers"]
    except A.AdapterError:
        return model
    for t in A.TIERS:
        tm = (tiers.get(t) or {}).get("model")
        if tm and tm.lower() in model.lower():
            return tm
    return model


_WM_CACHE = None


def _worker_metrics(task_ids=None):
    """task_id -> (agent, model, spec_len, in_tok, out_tok, gen_ms).
    Transcript metrics win; event-log durations fill the gaps. Full scans
    are slow (~10-20s for devin's DB), so the result is cached per process."""
    global _WM_CACHE
    if _WM_CACHE is None:
        _WM_CACHE = _worker_metrics_all()
    if task_ids is None:
        return _WM_CACHE
    return {t: v for t, v in _WM_CACHE.items() if t in task_ids}


def _worker_metrics_all():
    specs = {}
    try:
        for tid, ln in _ro_db(ORCA_DB).execute(
                "SELECT id, length(spec) FROM tasks"):
            specs[tid] = ln or 0
    except Exception:
        pass
    out = {}
    try:
        from orchlib import metrics
        readers = []
        for aid in A.list_ids():
            try:
                rd = (A.load(aid).get("transcript") or {}).get("reader")
            except A.AdapterError:
                continue
            if rd and rd not in readers:
                readers.append(rd)
        for tid, m in (metrics.collect_all(readers) or {}).items():
            ag = m.get("agent")
            out[tid] = (ag, _norm_model(ag, m.get("model")),
                        specs.get(tid, 0), m.get("in_tok") or 0,
                        m.get("out_tok") or 0, m.get("gen_ms") or 0)
    except Exception as e:
        print(f"orch: transcript metrics unavailable: {e}", file=sys.stderr)
    for tid, d in events.durations().items():
        if tid and tid not in out:
            out[tid] = (d.get("agent"), d.get("model"),
                        specs.get(tid, d.get("spec") or 0), 0, 0,
                        (d.get("gen_min") or 0) * 60000)
    return out


def _bucket(spec_len):
    return (0 if spec_len < SPEC_BUCKETS[0]
            else 1 if spec_len < SPEC_BUCKETS[1] else 2)


def _median(vals):
    vals = sorted(vals)
    return vals[len(vals) // 2] if vals else 0


def _estimate_weight(r, spec_len):
    """Median-based estimate for a resolved model spec; falls back
    (agent,model,bucket) -> (agent,model) -> agent -> global."""
    hist = collections.defaultdict(list)
    for ag, mdl, sl, inp, out, gen in _worker_metrics().values():
        v = (inp, out, gen)
        hist[("g",)].append(v)
        hist[("a", ag)].append(v)
        hist[("m", ag, mdl)].append(v)
        hist[("mb", ag, mdl, _bucket(sl))].append(v)
    ag, mdl = r["agent"], r.get("model")
    for key in (("mb", ag, mdl, _bucket(spec_len)), ("m", ag, mdl),
                ("a", ag), ("g",)):
        v = hist.get(key)
        if v:
            return {"in_tok": _median(x[0] for x in v),
                    "out_tok": _median(x[1] for x in v),
                    "gen_min": round(_median(x[2] for x in v) / 60000),
                    "n": len(v), "basis": key[0]}
    return None


def _record_estimate(run_id, task_id, name, r):
    try:
        est = _estimate_weight(r, _spec_len(task_id))
        if not est:
            return
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(ESTIMATES_FILE, "a") as f:
            f.write(json.dumps({
                "ts": int(time.time()), "run": run_id, "task": task_id,
                "name": name, "agent": r["agent"], "model": r.get("model"),
                "tier": r.get("tier"), "est": est},
                ensure_ascii=False) + "\n")
        print(f"orch: est for {name}: ~{est['in_tok']/1e6:.1f}M in / "
              f"~{est['gen_min']}min gen (median of {est['n']} past workers,"
              f" basis={est['basis']})", file=sys.stderr)
    except Exception:
        pass   # estimation is advisory; never block a spawn on it


def _spawn_rollback(wid, handle, branch):
    """Undo a half-spawn: close the terminal, force-rm the worktree, delete
    the branch. Measured incident: `worker-start failed` left one stale
    worktree+branch per attempt (17 worktrees / 62 branches accumulated in
    one run). Rollback is best-effort — every step is check=False."""
    if handle:
        orca("terminal", "close", "--terminal", handle, check=False)
    if wid:
        orca("worktree", "rm", "--worktree", f"id:{wid}", "--force",
             check=False)
    if branch:
        subprocess.run(["git", "branch", "-D", branch], capture_output=True)


def _hook_args(agent_id):
    """Per-launch hook injection (claude: --settings JSON) so the sleep
    policy holds without touching the user's global config."""
    try:
        from orchlib import hooks
        return hooks.launch_args(agent_id, HARNESS_DIR) or []
    except Exception:
        return []


def _spawn_one(run, tid, name, model, base, setup, repo, st, role="worker"):
    """worktree -> agent terminal (bypass!) -> worker-start --terminal.
    Any failure after the worktree exists rolls all created resources back."""
    r = _check_model_allowed(model, st)
    a = A.load(r["agent"])
    _check_parallel_cap(st, {a["provider"]: 1})
    wid = branch = handle = None
    try:
        wargs = ["worktree", "create", "--name", name]
        if base:
            wargs += ["--base-branch", base]
        if repo:
            wargs += ["--repo", repo]
        if setup:
            wargs += ["--setup", setup]
        w = orca(*wargs)
        wid = find_key(w, "id")
        branch = find_key(w, "branch") or ""
        branch = re.sub(r"^refs/heads/", "", branch)
        wpath = find_key(w, "path")
        if not wid:
            die(f"worktree create: no id in {json.dumps(w)[:400]}")

        cmd = A.launch_command(a, r, _hook_args(r["agent"]))
        t = orca("terminal", "create", "--worktree", f"id:{wid}",
                 "--title", name, "--command", cmd)
        handle = find_key(t, "handle")
        if not handle:
            die(f"terminal create: no handle in {json.dumps(t)[:400]}")
        if not _wait_ready(handle, a):
            print(f"orch: {r['agent']} TUI not ready after timeout; trying "
                  f"worker-start anyway. screen: "
                  f"{_screen_tail(handle, 6)[:300]}", file=sys.stderr)

        ws = orca("orchestration", "worker-start", "--task", tid,
                  "--terminal", handle, "--worktree", f"id:{wid}", check=False)
        # the prompt can land but stall at the input box ([Pasted text ...]
        # unsubmitted): press Enter once to submit, then retry the start
        if not ws or find_key(ws, "lastError") == "agent_prompt_stalled" \
                or find_key(ws, "state") == "failed":
            _submit_pending_paste(handle, a)
            ws = orca("orchestration", "worker-start", "--task", tid,
                      "--terminal", handle, "--worktree", f"id:{wid}",
                      check=False)
        if not ws or find_key(ws, "state") == "failed":
            die("worker-start failed: "
                f"{json.dumps(ws)[:600]}\nscreen tail: "
                f"{_screen_tail(handle, 10)[:400]}")
        did = (find_key(ws, "dispatchId") or find_key(ws, "dispatch")
               or find_key(ws, "id"))
        rec = {"dispatch": did, "task": tid, "name": name,
               "agent": r["agent"], "provider": a["provider"],
               "model": r.get("model") or r["spec"], "tier": r.get("tier"),
               "role": role, "worktree": wid, "path": wpath, "branch": branch,
               "base": base,
               "terminal": handle, "spawned_at": int(time.time()),
               "status": "active", "adopted": False}
        run["dispatches"][did] = rec
        run["tasks"].setdefault(tid, {}).setdefault("dispatches", []).append(did)
        state_save(st)
        events.emit("spawn", run=st.get("current_run"), dispatch=did,
                    task=tid, name=name, agent=r["agent"],
                    model=r.get("model"), tier=r.get("tier"), role=role,
                    spec_len=_spec_len(tid))
        _record_estimate(st.get("current_run"), tid, name, r)
        return rec
    except BaseException:
        _spawn_rollback(wid, handle, branch)
        raise


def _allow_tokens(st=None):
    """Max-tier allow tokens from TWO sources, either suffices:

      1. env ORCH_ALLOW — set by boot in the coordinator terminal
      2. run["allow"] persisted in .orch/state.json by `orch boot --allow`

    (2) exists because a measured incident had ORCH_ALLOW lost inside a
    coordinator-spawned BACKGROUND shell — env vars don't propagate to
    shells the coordinator starts later, so max-worker spawns were
    mysteriously rejected mid-run."""
    if st is None:
        st = state_load()
    run = (st.get("runs") or {}).get(st.get("current_run") or "", {})
    return (A.normalize_allow(os.environ.get("ORCH_ALLOW"))
            | A.normalize_allow(run.get("allow")))


def _resolve_model(model, st=None, agent=None):
    if st is None:
        st = state_load()
    run = (st.get("runs") or {}).get(st.get("current_run") or "", {})
    try:
        return A.resolve(model, A.default_agent(agent, run))
    except A.AdapterError as e:
        die(str(e))


def _check_model_allowed(model, st=None, agent=None):
    """Resolve a model spec and gate max tiers on --allow (adapter's
    gated tier/models; fuzzy CLIs like devin gate partial names too).
    Returns the resolved spec."""
    r = _resolve_model(model, st, agent)
    if not A.allowed(r, _allow_tokens(st)):
        die(f"model '{model}' resolves to {r['spec']} which is max-tier: "
            f"requires `orch boot --allow {r['agent']}:max` (or `--allow "
            "max` for every agent). No ORCH_ALLOW env and no persisted "
            "allow in .orch/state.json")
    return r


# ---------- Jev (TypeSafe System One) — opt-in semantic judgments ----------
#
# orch's structure is bimodal: deterministic checks (verify commands, dirty
# count) vs expensive coordinator judgment (reading every worktree). Jev
# fills the empty middle: typed probabilistic decisions at ~100-500ms and
# ~$0.042/1M input tokens. It never writes text and never decides adoption —
# it pre-screens, so the coordinator reviews the top few candidates instead
# of all of them (measured: 328 `orca eval` + 112 screenshots in one run).
#
# Two gates, both required: the --jev flag AND $TYPESAFE_API_KEY. Every Jev
# failure degrades to the non-Jev path — an early-access API must never be
# able to break a run. The ONE exception is the medium-on-ambiguous-spec
# block, which is mechanical enforcement (measured failure: medium proceeds
# on ambiguous specs without asking).

JEV_ENDPOINT = os.environ.get(
    "ORCH_JEV_ENDPOINT", "https://api.typesafe.ai/v1/systemone")
JEV_MODEL = "jev-latest"
JEV_AMBIGUITY_BLOCK = 0.7   # P(ambiguous) >= this + medium tier -> die
JEV_AMBIGUITY_WARN = 0.4    # P(ambiguous) >= this -> stderr warning


def _jev_enabled(args, st=None):
    """Opt-in paths (any suffices), ALL requiring TYPESAFE_API_KEY:
      1. --jev flag on the command
      2. ORCH_JEV env — set in the coordinator terminal by `boot --jev`
      3. run["jev"] persisted by `orch boot --jev` — the durable path,
         since env vars don't reach coordinator-spawned background shells
         (same lesson as ORCH_ALLOW)
    Opt-in without a key warns once and proceeds without Jev rather than
    dying — Jev is advisory and must never break a run."""
    want = bool(args.get("--jev") or os.environ.get("ORCH_JEV"))
    if not want:
        if st is None:
            st = state_load()
        run = (st.get("runs") or {}).get(st.get("current_run") or "", {})
        want = bool(run.get("jev"))
    if not want:
        return False
    if not os.environ.get("TYPESAFE_API_KEY"):
        print("orch: Jev is enabled for this run but TYPESAFE_API_KEY is "
              "not in the environment; continuing without Jev",
              file=sys.stderr)
        return False
    return True


def _jev_ask(state, questions, timeout=30):
    """POST state+typed questions to Jev; return the answers dict.
    Returns None on ANY failure (network/HTTP/parse) — callers degrade."""
    key = os.environ.get("TYPESAFE_API_KEY")
    if not key:
        return None
    body = json.dumps({"model": JEV_MODEL, "state": state,
                       "questions": questions}).encode()
    req = urllib.request.Request(
        JEV_ENDPOINT, data=body, method="POST",
        headers={"Authorization": f"Bearer {key}",
                 "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            doc = json.loads(r.read().decode())
        return doc.get("answers") or {}
    except Exception as e:
        print(f"orch: jev call failed (continuing without it): {e}",
              file=sys.stderr)
        return None


def _task_spec_text(run, tid):
    """Spec text recorded at task-create time, if the file still exists."""
    t = (run.get("tasks") or {}).get(tid) or {}
    sf = t.get("spec_file")
    if sf and os.path.isfile(sf):
        try:
            return open(sf).read()
        except OSError:
            return None
    return None


def _jev_spec_ambiguity(spec_text, args, st=None):
    """P(spec is unsafe for an autonomous worker) per Jev, or None when
    Jev is off / the call fails / there's no spec text to judge.

    Ambiguity has TWO failure modes (real-API calibration: a nearly empty
    spec scored low on "divergent readings" because it offers zero
    interpretations, while a spec with one undecided rule scored high) —
    so we decompose per the System One docs and take the max:
      vague     — not enough detail to start without guessing
      divergent — two reasonable readings yield different deliverables
    """
    if not _jev_enabled(args, st) or not spec_text:
        return None
    answers = _jev_ask(
        "Task spec handed to an autonomous coding worker:\n\n"
        + spec_text[:6000],
        {"vague": {
            "type": "noul",
            "instructions": "This spec lacks enough detail for a worker to "
                            "start without guessing at the goal, the "
                            "deliverable, or how success is judged"},
         "divergent": {
            "type": "noul",
            "instructions": "Two competent workers could build materially "
                            "DIFFERENT deliverables from this spec because "
                            "a decision that changes the outcome is left "
                            "unspecified — not merely missing minor details "
                            "a worker can reasonably default"}})
    if not answers:
        return None
    ps = [float(a["noul"]) for a in answers.values()
          if a.get("noul") is not None]
    return max(ps) if ps else None


def _spec_gate_apply(p, models, st=None):
    """Block the medium tier (any agent) on ambiguous specs (measured
    failure: swe-2-medium proceeds without asking, producing discarded
    work — the month log has 10/20 questions closed unanswered too).
    Other tiers warn only — high/max demonstrably flag spec bugs
    themselves."""
    if p is None:
        return
    rs = [_resolve_model(m, st) for m in models]
    if any(r.get("tier") == "medium" or "medium" in (r.get("model") or "")
           for r in rs) and p >= JEV_AMBIGUITY_BLOCK:
        die(f"Jev scores this spec ambiguous (p={p:.2f}) — medium proceeds "
            "without asking on ambiguous specs (measured). Clarify the spec "
            "or use a higher model tier")
    if p >= JEV_AMBIGUITY_WARN:
        print(f"orch: jev spec-ambiguity p={p:.2f}; consider clarifying",
              file=sys.stderr)


def _dispatch_state_text(d, run):
    """Bounded state for Jev: spec excerpt + worker meta + dirty count +
    report.md + worker-show. Jev judges MEANING, so include the artifacts'
    text — not just ids."""
    parts = [f"Worker: {d.get('name')} model={d.get('model')} "
             f"role={d.get('role')} branch={d.get('branch')}"]
    spec = _task_spec_text(run, d.get("task"))
    if spec:
        parts.append("TASK SPEC:\n" + spec[:3000])
    dirty = _git_dirty(d.get("path"))
    parts.append(f"Uncommitted paths in worktree: {len(dirty)}")
    rp = os.path.join(d.get("path") or "", "report.md")
    if os.path.isfile(rp):
        try:
            parts.append("worker report.md:\n" + open(rp).read()[:4000])
        except OSError:
            pass
    ws = orca("orchestration", "worker-show", "--dispatch", d["dispatch"],
              check=False)
    if ws:
        parts.append("worker status: " + json.dumps(ws)[:1500])
    return "\n\n".join(parts)


def _agent_spec(model, args):
    """Apply a command-level --agent to a bare tier/model."""
    ag = args.get("--agent")
    if ag and ":" not in model:
        return f"{ag}:{model}"
    return model


def _spec_for_agent(spec, agent_id):
    """Append the adapter's spec_notes (tool names, hook alternatives).
    Measured: workers re-learned the same hook block 3+ times per session
    when the alternative wasn't in the spec itself; the alternative is
    agent-specific (devin `workdir` vs claude Bash/Read tools)."""
    try:
        notes = A.spec_notes(A.load(agent_id))
    except A.AdapterError:
        notes = ""
    if not notes or notes in spec:
        return spec
    return f"{spec.rstrip()}\n\n## エージェント固有の注意 ({agent_id})\n{notes}\n"


def cmd_spawn(args):
    task = args.get("--task")
    if not task:
        die("usage: orch spawn --task <id> --name <n> [--model M] [--base B]")
    st = state_load()
    _, run = cur_run(st)
    model = _agent_spec(args.get("--model") or "", args)
    _check_model_allowed(model, st)
    _spec_gate_apply(
        _jev_spec_ambiguity(_task_spec_text(run, task), args, st), [model],
        st)
    rec = _spawn_one(run, task, args.get("--name") or f"w-{task[-6:]}",
                     model,
                     args.get("--base"), args.get("--setup") or "run",
                     args.get("--repo"), st)
    print(json.dumps(rec, indent=1))


def cmd_compete(args):
    """Create N candidate tasks from one spec and spawn a worker each."""
    files = args["_"]
    if not files:
        die("usage: orch compete <spec-file> -n 3 [--models high,medium,medium] [--cluster C] [--base B]")
    spec_file = files[0]
    n = int(args.get("-n") or 3)
    models = [_agent_spec(m.strip(), args)
              for m in (args.get("--models") or "").split(",") if m.strip()]
    default_models = [_agent_spec("high", args)] + \
        [_agent_spec("medium", args)] * (n - 1)
    models = (models + default_models[len(models):])[:n]
    st = state_load()
    rid, run = cur_run(st)
    need = collections.Counter()
    resolved = []
    for m in models:
        r = _check_model_allowed(m, st)
        resolved.append(r)
        need[A.load(r["agent"])["provider"]] += 1
    spec = open(spec_file).read()
    _spec_gate_apply(_jev_spec_ambiguity(spec, args, st), models, st)
    _check_parallel_cap(st, need)   # a compete is one candidate set —
                                    # spawning a partial set is worse than none
    cluster = args.get("--cluster") or os.path.splitext(os.path.basename(spec_file))[0]
    recs = []
    for i in range(n):
        title = f"{cluster}-{i+1}"
        r = orca("orchestration", "task-create", "--spec",
                 _spec_for_agent(spec, resolved[i]["agent"]),
                 "--task-title", title, "--run", rid)
        tid = find_key(r, "id") or find_key(r, "taskId")
        run["tasks"][tid] = {"title": title, "spec_file": spec_file,
                             "cluster": cluster, "deps": [], "dispatches": []}
        rec = _spawn_one(run, tid, f"w-{title}", models[i],
                         args.get("--base"), args.get("--setup") or "run",
                         args.get("--repo"), st, role="candidate")
        recs.append(rec)
    print(json.dumps(recs, indent=1))


def _item_spec_len(it):
    if it.get("task"):
        return _spec_len(it["task"])
    sf = it.get("spec_file")
    if sf and os.path.exists(sf):
        return len(open(sf).read())
    return 0


def _item_model(it, defaults, args=None):
    """Manifest item -> model spec. An item/defaults "agent" key prefixes
    a bare tier/model ("agent": "claude", "model": "high")."""
    m = it.get("model") or defaults.get("model") or ""
    ag = it.get("agent") or defaults.get("agent") or (args or {}).get("--agent")
    if ag and ":" not in m:
        m = f"{ag}:{m}"
    return m


def _item_est(it, defaults, st=None, args=None):
    """(model, est) for a manifest item — used by --sort-weight and
    `orch estimate` to order heavy tasks first (LPT)."""
    model = _item_model(it, defaults, args)
    return model, _estimate_weight(_resolve_model(model, st),
                                   _item_spec_len(it))


def cmd_estimate(args):
    """Preview weight estimates: `orch estimate manifest.json` or spec
    files. Sorted heaviest-first — the order that minimizes makespan."""
    files = args["_"]
    if not files:
        die("usage: orch estimate <manifest.json> | <spec-file>... [--model M]")
    rows = []
    if len(files) == 1 and files[0].endswith(".json"):
        man = json.loads(open(files[0]).read())
        defaults = man.get("defaults") or {}
        for it in man.get("items") or []:
            model, est = _item_est(it, defaults, args=args)
            rows.append({"name": (it.get("name") or it.get("title")
                                  or it.get("spec_file") or it.get("task")),
                         "model": model,
                         "spec_len": _item_spec_len(it), "est": est})
    else:
        model = _agent_spec(args.get("--model") or "high", args)
        r = _resolve_model(model)
        for f in files:
            est = _estimate_weight(r, len(open(f).read()))
            rows.append({"name": f, "model": model, "est": est})
    rows.sort(key=lambda r: -((r["est"] or {}).get("gen_min", 0)))
    print(json.dumps(rows, indent=1, ensure_ascii=False))


def cmd_batch(args):
    """Serial spawn loop driven by a JSON manifest — the mass-spawn path.

    Measured incident: a coordinator hand-rolled a bash loop with
    `declare -A` (absent on macOS bash 3.2) to map tasks→models; the map
    silently broke, dispatching a WRONG spec to one worker and storming
    `worker-start failed` on the rest (17 stale worktrees). Putting the
    assignment in a JSON file makes the mapping auditable data, and
    keeping the loop inside orch gives pacing/rollback/retry for free.

    Manifest:
      {"defaults": {"model": "medium", "agent": "claude", "setup": "run"},
       "items": [
         {"spec_file": "tasks/w01.md", "title": "w01", "cluster": "works",
          "name": "w01-x", "model": "codex:high"},
         {"task": "task_abc", "name": "w-retry", "model": "swe-2-medium"}
       ]}
    Each item needs EITHER "task" (existing task id) OR "spec_file"
    (creates a task first; title/cluster default from the file name).
    """
    files = args["_"]
    if not files:
        die("usage: orch batch <manifest.json> [--gap-sec N] [--retries N] "
            "[--sort-weight]")
    man = json.loads(open(files[0]).read())
    items = man.get("items") or []
    if not items:
        die("manifest has no items")
    defaults = man.get("defaults") or {}
    gap = float(args.get("--gap-sec") or 8)
    retries = int(args.get("--retries") or 1)
    st = state_load()
    rid, run = cur_run(st)
    for it in items:
        _check_model_allowed(_item_model(it, defaults, args), st)
    if args.get("--sort-weight"):
        # LPT: longest tasks first minimizes the makespan tail — the
        # "integration waits for the slowest worker" failure mode
        scored = []
        for it in items:
            model, est = _item_est(it, defaults, st, args)
            scored.append(((est or {}).get("gen_min", 0), it))
        scored.sort(key=lambda x: -x[0])
        items = [it for _, it in scored]
        for gm, it in scored:
            print(f"orch: order {it.get('name') or it.get('title') or '?'}: "
                  f"~{gm}min est", file=sys.stderr)

    ok, failed, deferred = [], [], []
    cap_hit = False
    for i, it in enumerate(items):
        if cap_hit:
            deferred.append(it)
            continue
        if i:
            time.sleep(gap)   # pacing: back-to-back spawns triggered
                              # `worker-start failed: null` (rate limit?)
        try:
            tid = it.get("task")
            spec = None
            # cap first: a deferred item is re-run from the manifest later,
            # so creating its task now would leave an orphan per deferral
            _check_parallel_cap(st, {A.load(_resolve_model(
                _item_model(it, defaults, args), st)["agent"])["provider"]: 1})
            if not tid:
                spec_file = it.get("spec_file")
                if not spec_file:
                    raise ValueError("item needs 'task' or 'spec_file'")
                name_r = _resolve_model(_item_model(it, defaults, args), st)
                spec = _spec_for_agent(open(spec_file).read(),
                                       name_r["agent"])
                title = (it.get("title")
                         or os.path.splitext(os.path.basename(spec_file))[0])
                r = orca("orchestration", "task-create", "--spec", spec,
                         "--task-title", title, "--run", rid)
                tid = find_key(r, "id") or find_key(r, "taskId")
                run["tasks"][tid] = {
                    "title": title, "spec_file": spec_file,
                    "cluster": it.get("cluster") or man.get("cluster"),
                    "deps": [], "dispatches": []}
            name = it.get("name") or f"w-{tid[-6:]}"
            model = _item_model(it, defaults, args)
            _spec_gate_apply(
                _jev_spec_ambiguity(
                    spec if spec is not None
                    else _task_spec_text(run, tid), args, st),
                [model], st)
            rec = None
            err = None
            for attempt in range(retries + 1):
                try:
                    rec = _spawn_one(
                        run, tid, name, model,
                        it.get("base") or defaults.get("base"),
                        it.get("setup") or defaults.get("setup") or "run",
                        it.get("repo") or defaults.get("repo"), st,
                        role=it.get("role") or "worker")
                    break
                except SystemExit as e:
                    err = e
                    if attempt < retries:
                        time.sleep(max(gap, 15))
            if rec:
                ok.append({"name": name, "dispatch": rec["dispatch"]})
            else:
                failed.append({"name": name, "error": str(err)})
                print(f"orch: spawn failed for {name}: {err}",
                      file=sys.stderr)
        except ParallelCapReached as e:
            # account quota cap: every remaining item would fail the same
            # way — stop here and hand the leftover manifest back
            cap_hit = True
            deferred.append(it)
            print(f"orch: {e}", file=sys.stderr)
        except Exception as e:
            failed.append({"name": it.get("name") or "?", "error": str(e)})
            print(f"orch: item failed: {e}", file=sys.stderr)
    state_save(st)
    out = {"spawned": ok, "failed": failed}
    if deferred:
        out["deferred"] = deferred
        out["note"] = ("parallel cap reached mid-batch — clean finished "
                       "workers (`orch collect`/`orch clean`) then re-run "
                       "the deferred items as a new manifest")
    print(json.dumps(out, indent=1, ensure_ascii=False))
    if cap_hit:
        sys.exit(3)
    if failed:
        sys.exit(2)


def cmd_weights(args):
    """Show recorded spawn estimates joined with actual worker metrics —
    the reviewable 'predicted vs actual' log (.orch/estimates.jsonl)."""
    if not os.path.exists(ESTIMATES_FILE):
        die("no estimates yet — they are recorded at spawn time")
    entries = [json.loads(l) for l in open(ESTIMATES_FILE) if l.strip()]
    actual = _worker_metrics({e["task"] for e in entries if e.get("task")})
    rows = []
    for e in entries:
        a = actual.get(e.get("task"))
        r = dict(e)
        if a:
            r["actual"] = {"agent": a[0], "in_tok": a[3], "out_tok": a[4],
                           "gen_min": round(a[5] / 60000)}
        rows.append(r)
    print(json.dumps(rows, indent=1, ensure_ascii=False))


WAIT_TYPES = "worker_done,escalation,question"


def _normalize_msg(m):
    payload = m.get("payload")
    if isinstance(payload, str):
        try:
            payload = json.loads(payload)
        except Exception:
            payload = {}
    payload = payload or {}
    return {
        "type": m.get("type"),
        "from": m.get("from_handle") or m.get("from") or m.get("fromHandle"),
        "subject": m.get("subject"),
        "body": (m.get("body") or "")[:600],
        "task": payload.get("taskId") or m.get("task_id"),
        "dispatch": payload.get("dispatchId") or m.get("dispatch_id"),
        "outcome": payload.get("outcome"),
        "files": payload.get("filesModified"),
        "id": m.get("id") or m.get("messageId"),
    }


def cmd_wait(args):
    timeout = float(args.get("--timeout-min") or 60) * 60
    st = state_load()
    _, run = cur_run(st)
    known = set(run["dispatches"])
    settled = set()
    deadline = time.time() + timeout
    ack = None
    while time.time() < deadline:
        remain_ms = int(max(5_000, min(300_000, (deadline - time.time()) * 1000)))
        cargs = ["orchestration", "check", "--wait",
                 "--types", WAIT_TYPES, "--timeout-ms", str(remain_ms)]
        if ack:
            cargs += ["--ack", ack]
        r = orca(*cargs, check=False, timeout=remain_ms / 1000 + 30)
        if r is None:
            continue
        delivery = r if isinstance(r, dict) else {}
        msgs = find_key(delivery, "messages", []) or []
        did_ack = find_key(delivery, "deliveryId") or delivery.get("id")
        for m in msgs:
            nm = _normalize_msg(m)
            print(json.dumps(nm, ensure_ascii=False), flush=True)
            if nm["type"] in ("worker_done", "escalation") and nm["dispatch"]:
                settled.add(nm["dispatch"])
            if nm["type"] == "worker_done" and nm["dispatch"]:
                # orch's own completion record: durations for agents
                # without a transcript reader, and the second half of
                # "worker_done vs committed artifacts" reconciliation
                events.emit("done", dispatch=nm["dispatch"], task=nm["task"],
                            outcome=nm["outcome"])
        if did_ack:
            ack = str(did_ack)
            # ack is chained into the next check call (--ack + --wait)
        if args.get("--settle-all") and known and settled >= known:
            break
    print(json.dumps({"settled": sorted(settled),
                      "pending": sorted(known - settled)}))


# worker-show states meaning "accepted but not yet executing" — a dispatch
# stuck here past --stale-min is a zombie, not a slow worker
NEVER_STARTED_STATES = {"dispatched", "pending", "created", "starting",
                        "accepted", "queued"}
# Orca's agentWait kinds (worker-show observation) that mean a human-style
# gate is on screen — authoritative when present (hooks/OSC/screen rules)
ORCA_BLOCKED_KINDS = ("approval", "trust", "cwd", "interactive", "update",
                      "hooks-review", "model-migration")


def _adapter_of(d):
    try:
        return A.load(d.get("agent") or A.DEFAULT_AGENT)
    except A.AdapterError:
        return A.load("generic")


def _lower_cap(st, run, provider):
    """On a rate limit, halve that provider's cap (floor 1) and persist it
    — the next spawn/batch then defers instead of re-tripping the quota."""
    live = _live_by_provider()[provider]
    cur = _parallel_cap(st, provider)
    new = max(1, min(cur if cur > 0 else live, live) // 2)
    if cur <= 0 or new < cur:
        run.setdefault("caps_auto", {})[provider] = new
        events.emit("cap_lowered", provider=provider, old=cur, new=new,
                    live=live)
        return new
    return None


def cmd_patrol(args):
    st = state_load()
    _, run = cur_run(st)
    jev = _jev_enabled(args, st)
    stale_s = float(args.get("--stale-min") or 12) * 60
    cooldown_s = float(args.get("--cooldown-min") or 10) * 60
    now = time.time()
    report = []
    limited = set()
    for did, d in run["dispatches"].items():
        if d.get("status") != "active":
            continue
        a = _adapter_of(d)
        entry = {"dispatch": did, "name": d["name"],
                 "agent": a["id"], "issues": []}
        ws = orca("orchestration", "worker-show", "--dispatch", did, check=False)
        wstate = (find_key(ws, "status") or find_key(ws, "state") or "?") if ws else "?"
        entry["worker_state"] = wstate
        # Orca's own observation first: it knows hook-reported turn state
        # for the agents it supports; screen regexes are the fallback
        aw = find_key(ws, "agentWait") if ws else None
        if isinstance(aw, dict):
            kind = aw.get("kind") or aw.get("reason") or aw.get("state")
            if kind:
                entry["orca_wait"] = kind
                if any(k in str(kind) for k in ORCA_BLOCKED_KINDS):
                    entry["issues"].append(f"orca-blocked:{kind}")
        tail = _screen_tail(d["terminal"], 60)
        key = A.approval_key(a, tail)
        if key or A.screen_match(a, "approval", tail):
            entry["issues"].append("permission-menu")
            if key and args.get("--rescue"):
                _send_keys(d["terminal"], [key, "enter"])
                entry["issues"].append(f"rescued:key={key}")
        gate = A.startup_prompt(a, tail)
        if gate:
            entry["issues"].append("startup-gate")
            if args.get("--rescue"):
                _send_keys(d["terminal"], gate)
                entry["issues"].append("rescued:startup-gate")
        if A.screen_match(a, "rate_limit", tail):
            # measured: 56 devin processes hit the account-wide limit in
            # two days and a human typed 95 resume prompts. Detect, shrink
            # the provider cap, and resume after a cooldown mechanically.
            entry["issues"].append("rate-limited")
            limited.add(a["provider"])
            if not d.get("rate_limited_at"):
                d["rate_limited_at"] = int(now)
                events.emit("rate_limit", dispatch=did, agent=a["id"],
                            provider=a["provider"])
            elif args.get("--rescue") and \
                    now - d["rate_limited_at"] >= cooldown_s:
                orca("terminal", "send", "--terminal", d["terminal"],
                     "--text", a.get("resume_text") or "continue",
                     "--enter", check=False)
                d["rate_limited_at"] = None
                d["resumed"] = d.get("resumed", 0) + 1
                entry["issues"].append("rescued:resume-sent")
        elif d.get("rate_limited_at"):
            d["rate_limited_at"] = None
        if jev and tail:
            # semantic stuck-detection: the heuristic checks above only see
            # state names + elapsed time; Jev reads the screen for meaning
            ja = _jev_ask(
                "Screen tail of a supervised autonomous worker terminal:\n\n"
                + tail[-2000:],
                {"stuck": {
                    "type": "noul",
                    "instructions": "The worker is stopped or idle — waiting "
                                    "on a prompt, an unanswered question, an "
                                    "error state, or sitting at a fresh "
                                    "prompt with no task in progress"}})
            sp = ((ja or {}).get("stuck") or {}).get("noul")
            if sp is not None and float(sp) >= 0.6:
                entry["issues"].append(f"jev-stuck:p={float(sp):.2f}")
        idle = now - d.get("spawned_at", now)
        if idle > stale_s:
            if wstate in ("ready", "running", "active", "?"):
                # heartbeats are optional (22-37% of workers never sent
                # one in the month log) — flag long-running actives for
                # eyeball instead of trusting their absence
                entry["issues"].append(f"running>{int(idle/60)}m")
            elif wstate in NEVER_STARTED_STATES:
                # measured incident: a dispatch whose agent session never
                # started (prompt injection silently failed) sat for hours
                # looking identical to a live worker in `orch status`
                entry["issues"].append(
                    f"zombie? state={wstate} for {int(idle/60)}m "
                    "(spawned but never started — likely a failed prompt "
                    "injection; clean + respawn)")
        if entry["issues"]:
            events.emit("patrol", dispatch=did, issues=entry["issues"])
        report.append(entry)
    caps = {}
    for prov in sorted(limited):
        new = _lower_cap(st, run, prov)
        if new is not None:
            caps[prov] = new
    state_save(st)
    out = report
    if caps:
        out = {"dispatches": report, "caps_lowered": caps,
               "note": "rate limit seen — provider caps halved and "
                       "persisted; `orch patrol --rescue` resumes limited "
                       "workers after --cooldown-min (default 10)"}
    print(json.dumps(out, indent=1, ensure_ascii=False))


def _git_dirty(path):
    """Uncommitted paths in a worktree (worker commit-forgetfulness is a
    measured failure — `orch adopt` used to silently adopt empty branches)."""
    if not path or not os.path.isdir(path):
        return []
    p = subprocess.run(["git", "-C", path, "status", "--porcelain"],
                       capture_output=True, text=True)
    return [ln for ln in p.stdout.splitlines() if ln.strip()]


def _git_commits(path, base=None):
    """Commits on the worker branch not on its base (None if unknown)."""
    if not path or not os.path.isdir(path):
        return None
    refs = [base] if base else []
    refs += ["origin/HEAD", "main", "master"]
    for ref in refs:
        p = subprocess.run(["git", "-C", path, "rev-list", "--count",
                            f"{ref}..HEAD"], capture_output=True, text=True)
        if p.returncode == 0:
            try:
                return int(p.stdout.strip())
            except ValueError:
                return None
    return None


def cmd_collect(args):
    st = state_load()
    _, run = cur_run(st)
    rows = []
    for did, d in run["dispatches"].items():
        ws = orca("orchestration", "worker-show", "--dispatch", did, check=False)
        rows.append({
            "dispatch": did, "name": d["name"], "model": d["model"],
            "branch": d.get("branch"), "path": d.get("path"),
            "status": find_key(ws, "status") or find_key(ws, "state") or d["status"],
            "outcome": find_key(ws, "outcome"),
            "adopted": d.get("adopted", False),
            "dirty": len(_git_dirty(d.get("path"))),
            "commits": _git_commits(d.get("path"), d.get("base")),
        })
        r = rows[-1]
        if r["outcome"] == "succeeded" and not r["commits"] \
                and d.get("role") != "reviewer":
            # reconcile the two completion records: worker_done claimed
            # success but the branch carries nothing (measured: artifacts
            # left uncommitted after worker_done)
            r["warning"] = "worker_done succeeded but 0 commits on branch"
    print(json.dumps(rows, indent=1, ensure_ascii=False))


def cmd_adopt(args):
    did = args.get("--dispatch")
    if not did:
        die("usage: orch adopt --dispatch <id>")
    st = state_load()
    _, run = cur_run(st)
    if did not in run["dispatches"]:
        die(f"unknown dispatch {did}")
    d = run["dispatches"][did]
    dirty = _git_dirty(d.get("path"))
    warnings = []
    if _jev_enabled(args, st):
        # done-claim sanity: measured failures had worker_done fire with
        # artifacts uncommitted / verification skipped. Advisory — adoption
        # stays the coordinator's judgment.
        a = _jev_ask(
            _dispatch_state_text(d, run),
            {"completed": {
                "type": "noul",
                "instructions": "The evidence indicates the worker actually "
                                "completed the task spec — artifacts exist "
                                "and verification ran — not merely claimed "
                                "completion"}})
        cp = ((a or {}).get("completed") or {}).get("noul")
        if cp is not None:
            jev_p = round(float(cp), 3)
            if jev_p < 0.5:
                warnings.append(
                    f"Jev doubts completion (p={jev_p:.2f}) — inspect the "
                    "worktree before integrating")
        else:
            jev_p = None
    else:
        jev_p = None
    d["adopted"] = True
    d["adopted_at"] = int(time.time())
    state_save(st)
    events.emit("adopt", dispatch=did, task=d.get("task"),
                agent=d.get("agent"), dirty=len(dirty))
    out = {"adopted": did, "branch": d.get("branch")}
    if jev_p is not None:
        out["jev_completed_p"] = jev_p
    if dirty:
        # warn, don't block: the coordinator may adopt intentionally, but a
        # measured incident had worker_done fire with artifacts uncommitted
        warnings.append(f"worktree has {len(dirty)} uncommitted paths — "
                        "adopting merges only what's committed")
        out["dirty_paths"] = dirty[:20]
    if warnings:
        out["warning"] = "; ".join(warnings)
    print(json.dumps(out, ensure_ascii=False))


def cmd_score(args):
    """Jev pre-screen: rank candidates against their specs so the
    coordinator reviews the top few worktrees instead of every one
    (measured: 328 `orca eval` calls + 112 screenshots in a single run —
    the coordinator inspected everything). Advisory only: this prints a
    ranking; `orch adopt` stays the coordinator's decision.

    The command itself is the opt-in — it requires TYPESAFE_API_KEY.
    """
    if not os.environ.get("TYPESAFE_API_KEY"):
        die("orch score requires TYPESAFE_API_KEY in the environment")
    st = state_load()
    _, run = cur_run(st)
    cluster = args.get("--cluster")
    only = set((args.get("--dispatch") or "").split(",")) - {""}
    rows = []
    for did, d in run["dispatches"].items():
        if d.get("status") == "released" or d.get("adopted"):
            continue
        if only and did not in only:
            continue
        if cluster:
            t = (run.get("tasks") or {}).get(d.get("task")) or {}
            if t.get("cluster") != cluster:
                continue
        a = _jev_ask(
            _dispatch_state_text(d, run),
            {"satisfies": {
                "type": "noul",
                "instructions": "Based on the report and status evidence, "
                                "the worker delivered what the task spec "
                                "requires"},
             "quality": {
                 "type": "score",
                 "instructions": "Adoption-worthiness of this submission",
                 "criteria": ["reject — broken, off-spec, or empty",
                              "weak — partial or unverified",
                              "solid — meets spec with verification",
                              "strong — exceeds spec, clean evidence"]}})
        a = a or {}
        rows.append({
            "dispatch": did, "name": d.get("name"),
            "model": d.get("model"), "branch": d.get("branch"),
            "dirty": len(_git_dirty(d.get("path"))),
            "jev_satisfies_p": (a.get("satisfies") or {}).get("noul"),
            "jev_quality": (a.get("quality") or {}).get("score"),
            "jev_confidence": (a.get("quality") or {}).get("confidence"),
            "jev_legend": (a.get("quality") or {}).get("legend"),
        })
    rows.sort(key=lambda r: (r.get("jev_quality") is not None,
                             r.get("jev_quality") or 0), reverse=True)
    print(json.dumps({"ranking": rows,
                      "note": "advisory — review top candidates yourself; "
                              "orch adopt stays your call"},
                     indent=1, ensure_ascii=False))


def cmd_integrate(args):
    """Spawn an integrator worker that merges adopted branches."""
    topic = args.get("--topic")
    branches = args.get("--branches")
    if not topic or not branches:
        die("usage: orch integrate --topic <t> --branches b1,b2 [--model M] [--verify 'cmd']")
    integ_model = _agent_spec(args.get("--model") or "high", args)
    st = state_load()
    ir = _check_model_allowed(integ_model, st)
    tpl_path = os.path.join(HARNESS_DIR, "tasks", "integrator.template.md")
    tpl = open(tpl_path).read()
    spec = (tpl.replace("{{TOPIC}}", topic)
               .replace("{{BRANCHES}}", branches)
               .replace("{{VERIFY}}", args.get("--verify") or "(repo の検証コマンド)"))
    rid, run = cur_run(st)
    r = orca("orchestration", "task-create", "--spec",
             _spec_for_agent(spec, ir["agent"]),
             "--task-title", f"integ-{topic}", "--run", rid)
    tid = find_key(r, "id") or find_key(r, "taskId")
    run["tasks"][tid] = {"title": f"integ-{topic}", "cluster": f"integ:{topic}",
                         "deps": [], "dispatches": []}
    rec = _spawn_one(run, tid, f"integ-{topic}",
                     integ_model,
                     args.get("--base"), args.get("--setup") or "run",
                     args.get("--repo"), st, role="integrator")
    print(json.dumps(rec, indent=1))


def _cluster_of(run, rec):
    """Cluster a dispatch belongs to (via its task). None for clusterless."""
    return (run["tasks"].get(rec.get("task")) or {}).get("cluster")


def _loser_ids(run):
    """Dispatches that verifiably LOST a decided competition: un-adopted,
    and their cluster has a sibling adopted after they were spawned.

    `--losers` must never mean "everything un-adopted": integrators,
    reviewers and retried candidates are always un-adopted, and a measured
    incident had `clean --losers` kill a freshly spawned integrator.
    Candidates spawned AFTER their cluster's decision (retries) are kept."""
    disp = run["dispatches"]
    out = []
    for did, d in disp.items():
        if d.get("adopted") or d.get("status") == "released":
            continue
        cl = _cluster_of(run, d)
        if not cl:
            continue
        decided_at = max((s.get("adopted_at", float("inf"))
                          for s in disp.values()
                          if s.get("adopted") and _cluster_of(run, s) == cl),
                         default=None)
        if decided_at is not None and d.get("spawned_at", 0) <= decided_at:
            out.append(did)
    return out


def cmd_clean(args):
    st = state_load()
    _, run = cur_run(st)
    disp = run["dispatches"]
    kept = []
    if args.get("--all"):
        targets = list(disp)
    elif args.get("--losers"):
        targets = _loser_ids(run)
        kept = [{"dispatch": did, "name": d["name"],
                 "role": d.get("role"), "cluster": _cluster_of(run, d),
                 "reason": "not a decided loser "
                           "(use --cluster <c> or an explicit dispatch id)"}
                for did, d in disp.items()
                if did not in targets and not d.get("adopted")
                and d.get("status") != "released"]
    elif args.get("--cluster"):
        cl = args["--cluster"]
        targets = [did for did, d in disp.items()
                   if not d.get("adopted") and _cluster_of(run, d) == cl]
        kept = [{"dispatch": did, "name": d["name"], "reason": "adopted"}
                for did, d in disp.items()
                if d.get("adopted") and _cluster_of(run, d) == cl]
    else:
        targets = [d for d in args["_"]]
        if args.get("--dispatch"):
            targets.append(args["--dispatch"])
    if not targets and not kept:
        die("usage: orch clean <dispatch>... | --losers | --cluster <c> | --all")
    done = []
    for did in targets:
        d = disp.get(did)
        if not d or d.get("status") == "released":
            continue
        orca("orchestration", "worker-release", "--dispatch", did, check=False)
        if d.get("worktree"):
            orca("worktree", "rm", "--worktree", f"id:{d['worktree']}",
                 "--force", check=False)
            tl = orca("terminal", "list", "--worktree", f"id:{d['worktree']}",
                      check=False)
            for t in (find_key(tl, "terminals", []) or []):
                h = t.get("handle")
                if h:
                    orca("terminal", "close", "--terminal", h, check=False)
        # `worktree rm --force` does not delete the branch; drop the loser's
        # branch too (adopted branches are kept until integration completes).
        if d.get("branch") and not d.get("adopted"):
            subprocess.run(["git", "branch", "-D", d["branch"]],
                           capture_output=True)
        d["status"] = "released"
        events.emit("clean", dispatch=did, adopted=d.get("adopted"))
        done.append(did)
    state_save(st)
    print(json.dumps({"released": done, "kept": kept}, ensure_ascii=False))


def cmd_status(args):
    st = state_load()
    rid, run = cur_run(st)
    tasks = orca("orchestration", "task-list", "--run", rid, "--brief",
                 check=False) or {}
    active = _live_by_provider()
    provs = sorted(set(active) | {d.get("provider") or "cognition"
                                  for d in run["dispatches"].values()})
    print(json.dumps({
        "run": rid, "objective": run["objective"],
        "default_agent": A.default_agent(None, run),
        "allow": sorted(_allow_tokens(st)),
        "providers": {p: {"active_sessions": active[p],
                          "cap": _parallel_cap(st, p)} for p in provs},
        "live_devin_processes": _live_devin(active_only=False),
        "idle_min": _idle_min(),
        "tasks": find_key(tasks, "tasks", tasks),
        "dispatches": [
            {"dispatch": k, "name": v["name"],
             "agent": v.get("agent") or "devin", "model": v["model"],
             "role": v.get("role"), "status": v["status"],
             "adopted": v["adopted"],
             "branch": v.get("branch"), "age_min": int((time.time() - v["spawned_at"]) / 60)}
            for k, v in run["dispatches"].items()],
    }, indent=1, ensure_ascii=False))


def _model_freshness(a, args):
    """Compare tier models with the CLI's live model list (only for
    installed CLIs; --no-models skips the lookup)."""
    if args.get("--no-models") or not a.get("models", {}).get("list_source"):
        return {}
    import shutil
    if not shutil.which(A.binary(a).split()[0]):
        return {}
    avail = A.available_models(a)
    if avail is None:
        return {"models_checked": False}
    out = {"models_checked": True,
           "stale_models": A.stale_models(a, avail)}
    if out["stale_models"]:
        out["available_models"] = avail[:12]
    return out


def cmd_agents(args):
    """List adapters with what this machine can actually run."""
    import shutil
    if args.get("--check"):
        # what spawn would run — no terminal is created
        r = _resolve_model(_agent_spec(args["--check"], args)
                           if isinstance(args["--check"], str) else "", None)
        a = A.load(r["agent"])
        print(json.dumps({"resolved": r,
                          "command": A.launch_command(a, r,
                                                      _hook_args(r["agent"])),
                          "gated": A.is_gated(r)}, indent=1,
                         ensure_ascii=False))
        return
    rows = []
    for aid in A.list_ids():
        try:
            a = A.load(aid)
        except A.AdapterError as e:
            rows.append({"agent": aid, "error": str(e)})
            continue
        b = A.binary(a)
        exe = shutil.which(b.split()[0]) if b else None
        rows.append({
            "agent": aid, "provider": a["provider"],
            "binary": b, "found": bool(exe),
            "tiers": {t: " ".join(x for x in (
                (a["models"]["tiers"].get(t) or {}).get("model") or "(config)",
                (a["models"]["tiers"].get(t) or {}).get("effort") or "") if x)
                for t in A.TIERS},
            "live": _live_count(a),
            **_model_freshness(a, args),
            "transcript": (a.get("transcript") or {}).get("reader"),
            "hooks": (a.get("hooks") or {}).get("installer"),
            "unverified": sorted(k for k, v in (a.get("verified") or {}).items()
                                 if v is False),
            "source": os.path.relpath(a["_path"]),
        })
    print(json.dumps(rows, indent=1, ensure_ascii=False))


def cmd_hooks_install(args):
    """Persistent hook install for agents that need it (devin global
    config, opencode plugin, codex hooks.json). claude needs none — the
    hook rides on every launch via --settings. Dry run unless --apply."""
    st = state_load()
    agent = args.get("--agent") or A.default_agent(
        None, (st.get("runs") or {}).get(st.get("current_run") or "", {}))
    try:
        from orchlib import hooks
    except Exception as e:
        die(f"hooks module unavailable: {e}")
    print(json.dumps(hooks.install(agent, HARNESS_DIR,
                                   dry_run=not args.get("--apply")),
                     indent=1, ensure_ascii=False))


def _resolve_worktree(args):
    """--worktree flag > current Orca worktree > repo main worktree of cwd."""
    if args.get("--worktree"):
        return args["--worktree"]
    cur = orca("worktree", "current", check=False)
    wid = find_key(cur, "id") if cur else None
    if wid:
        return f"id:{wid}"
    cwd = os.path.abspath(os.getcwd())
    repos = find_key(orca("repo", "list"), "repos", []) or []
    repo = next((r for r in repos if cwd.startswith(r["path"])), None)
    if repo:
        wts = find_key(orca("worktree", "list", "--repo", f"id:{repo['id']}"),
                       "worktrees", []) or []
        main = next((w for w in wts if w.get("isMainWorktree")), None)
        if main:
            return f"id:{main['id']}"
    die("cannot resolve worktree: run inside an Orca-managed repo or pass --worktree")


def _parse_caps(v):
    """--cap N | --cap provider=N[,provider=N] -> (global, {provider: N})."""
    glob_cap, caps = None, {}
    for part in str(v).split(","):
        part = part.strip()
        if not part:
            continue
        try:
            if "=" in part:
                k, n = part.split("=", 1)
                caps[k.strip()] = int(n)
            else:
                glob_cap = int(part)
        except ValueError:
            die(f"bad --cap value: {v} (N or provider=N[,..]; 0 disables)")
    return glob_cap, caps


def cmd_boot(args):
    """Spawn a coordinator agent terminal that runs playbooks/coordinator.md."""
    files = args["_"]
    if not files:
        die("usage: orch boot <requirement-file> [--agent devin|claude|codex|"
            "opencode] [--allow max|<agent>[:max],..] [--jev] "
            "[--cap N|provider=N,..] [--worktree sel]")
    if args.get("--model"):
        die("--model is gone: the coordinator runs on its agent's high tier. "
            "Use --allow <agent>:max to run the coordinator and workers on max")
    agent = args.get("--agent") or os.environ.get("ORCH_AGENT") or A.DEFAULT_AGENT
    try:
        a = A.load(agent)
    except A.AdapterError as e:
        die(str(e))
    allow_tokens = A.normalize_allow(args.get("--allow"))
    for tok in allow_tokens:
        ag = tok.split(":", 1)[0]
        if ag != "*" and ag not in A.list_ids():
            die(f"unknown --allow value: {tok} (max | <agent>[:max] | "
                "swe-2-max)")
    glob_cap, caps = (_parse_caps(args["--cap"])
                      if args.get("--cap") is not None else (None, {}))
    jev = bool(args.get("--jev"))
    req = os.path.abspath(files[0])
    obj = open(req).read().strip().splitlines()[0][:200]
    r = orca("orchestration", "run-create", "--objective", obj)
    rid = find_key(r, "id") or find_key(r, "runId")
    st = state_load()
    st["runs"][rid] = {"objective": obj, "created_at": int(time.time()),
                     "tasks": {}, "dispatches": {}, "agent": agent,
                     "allow": sorted(allow_tokens), "jev": jev}
    if glob_cap is not None:
        st["runs"][rid]["parallel_cap"] = glob_cap
    if caps:
        st["runs"][rid]["caps"] = caps
    st["current_run"] = rid
    state_save(st)
    _check_parallel_cap(st, {a["provider"]: 1})

    # the coordinator runs on its agent's high tier; an allow covering that
    # agent's max upgrades the coordinator itself AND lets workers use max.
    # The allow is persisted in run state (above) so it survives background
    # shells that lose ORCH_ALLOW — env vars don't reach shells the
    # coordinator spawns later (measured incident: max spawns rejected
    # mid-run). Same for --jev / --agent / caps.
    mr = A.resolve(f"{agent}:max")
    cr = mr if A.allowed(mr, allow_tokens) else A.resolve(f"{agent}:high")
    eff_cap = _parallel_cap(st, a["provider"])
    env = {"ORCH_ALLOW": ",".join(sorted(allow_tokens)),
           "ORCH_JEV": "1" if jev else "", "ORCH_AGENT": agent}
    cmd = A.launch_command(a, cr, _hook_args(agent), env=env)
    wt = _resolve_worktree(args)
    t = orca("terminal", "create", "--worktree", wt, "--title", "coordinator",
             "--command", cmd)
    handle = find_key(t, "handle")
    _wait_ready(handle, a)
    playbook = os.path.join(HARNESS_DIR, "playbooks", "coordinator.md")
    agents_avail = ", ".join(A.list_ids())
    allow_txt = (f"max tier 使用可: {', '.join(sorted(allow_tokens))} "
                 "(allow は .orch/state.json に永続化済み・バックグラウンドシェルからでも有効)"
                 if allow_tokens else
                 "high tier まで。max tier はこのRunでは禁止(orch が機械的に拒否)")
    prompt = (
        f"あなたはこのRunのコーディネーターです(エージェント: {agent} / {cr['spec']})。\n"
        f"1. まず `orca orchestration run-use --id {rid}` でこの端末をRunにbindする\n"
        f"2. {playbook} を読み、要件ファイル {req} に対して実行する\n"
        f"3. ハーネスCLI: {HARNESS_DIR}/bin/orch (stateはこの端末のcwdの .orch/)\n"
        f"4. ワーカーのエージェント: 既定は {agent}(state永続化済み)。"
        f"`--model <agent>:<tier>` で混在可(利用可能: {agents_avail}。"
        f"`orch agents` で各CLIの有無と tier→モデル対応を確認)\n"
        f"5. モデル上限: {allow_txt}\n"
        f"6. Jev: {'このRunは --jev 有効。`orch score` で候補を事前採点して上位だけ実物審査し、spawn/compete/batch/patrol/adopt の Jev 判定は state 永続化により自動で効く(TYPESAFE_API_KEY が無ければ各コマンドが非Jev経路にフォールバック)' if jev else '無効。使うなら spawn/compete/batch/patrol/adopt に --jev を付ける(要 TYPESAFE_API_KEY)'}\n"
        f"7. 並列上限: provider ごと(このエージェントの {a['provider']} は {eff_cap} セッションまで・state永続化済み)。"
        f"cap到達で spawn/batch は拒否されるので、ワーカー完了後は `orch clean` で枠を解放してから次の波を投入する。"
        f"レート制限は `orch patrol` が検出して cap を自動で下げ、`--rescue` で cooldown 後に再開させる\n"
        f"8. 重さ予測: spawn時に (agent,model,spec長) 中央値ベースの予想が .orch/estimates.jsonl に記録される。"
        f"`orch weights` で予測vs実績を見返せる。大量投入は `orch estimate` で予測を見て `orch batch --sort-weight` で重い順に投げる\n"
        f"9. 待機は必ず `orch wait`。sleep・生の `orca orchestration worker-start` は使わない(orch spawn/batch/compete 経由のみ)"
    )
    ok = _send_prompt(handle, prompt, a)
    print(json.dumps({"run": rid, "coordinator_terminal": handle,
                      "agent": agent, "coordinator_model": cr["spec"],
                      "allow": sorted(allow_tokens), "jev": jev,
                      "parallel_cap": {a["provider"]: eff_cap},
                      "prompt_submitted": ok}, indent=1))


# ---------- dispatch ----------

COMMANDS = {
    "init": cmd_init,
    "run create": cmd_run_create,
    "task create": cmd_task_create,
    "spawn": cmd_spawn,
    "compete": cmd_compete,
    "batch": cmd_batch,
    "wait": cmd_wait,
    "patrol": cmd_patrol,
    "collect": cmd_collect,
    "score": cmd_score,
    "adopt": cmd_adopt,
    "integrate": cmd_integrate,
    "clean": cmd_clean,
    "status": cmd_status,
    "agents": cmd_agents,
    "hooks install": cmd_hooks_install,
    "weights": cmd_weights,
    "estimate": cmd_estimate,
    "boot": cmd_boot,
}


def _known_flags():
    """Every flag any command reads, scraped from this file — a typo'd
    flag used to be accepted and silently ignored (a third of failed orch
    calls in the month log were wrong arguments)."""
    try:
        src = open(os.path.abspath(__file__)).read()
    except OSError:
        return []
    return sorted(set(re.findall(r'args(?:\.get\(|\[)"(-[-\w]*)"', src)))


def parse(argv):
    """Split argv into (command, {flags, _ positional})."""
    for n in (2, 1):
        cand = " ".join(argv[:n])
        if cand in COMMANDS:
            rest = argv[n:]
            break
    else:
        # measured: about a third of failed orch calls in the month log
        # were wrong subcommands/arguments — suggest instead of just dying
        import difflib
        near = difflib.get_close_matches(" ".join(argv[:2]), list(COMMANDS),
                                         n=2, cutoff=0.5) or \
            difflib.get_close_matches(argv[0], list(COMMANDS), n=2,
                                      cutoff=0.5)
        die(f"unknown command: {' '.join(argv[:2])}"
            + (f" — did you mean: {', '.join(near)}?" if near else "")
            + "\ncommands: " + ", ".join(sorted(COMMANDS))
            + "\n(`orch --help` for usage)")
    args = {"_": []}
    known = _known_flags()
    i = 0
    while i < len(rest):
        a = rest[i]
        if a.startswith("-") and a.split("=", 1)[0] not in known:
            import difflib
            near = difflib.get_close_matches(a.split("=", 1)[0], known, n=2)
            die(f"unknown flag {a} for `orch {cand}`"
                + (f" — did you mean: {', '.join(near)}?" if near else "")
                + " (`orch --help`; usage examples are in AGENTS.md)")
        if a.startswith("-"):
            if "=" in a and a.startswith("--"):
                k, v = a.split("=", 1)
                args[k] = v
                i += 1
            elif i + 1 < len(rest) and not rest[i + 1].startswith("--"):
                args[a] = rest[i + 1]
                i += 2
            else:
                args[a] = True
                i += 1
        else:
            args["_"].append(a)
            i += 1
    return cand, args


if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(__doc__)
        sys.exit(0)
    name, args = parse(sys.argv[1:])
    try:
        COMMANDS[name](args)
    except ParallelCapReached as e:
        die(str(e), code=3)
