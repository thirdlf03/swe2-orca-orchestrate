{
  "objective": "例: ダッシュボードのUI改善",
  "repo": "path:/abs/path/to/repo",
  "coordinator": {"agent": "claude", "tier": "high"},
  "allow": [],
  "caps": {"anthropic": 6, "openai": 4, "cognition": 4},
  "defaults": {"agent": "claude", "base_branch": "main", "setup": "run", "verify": ["npx tsc --noEmit"]},
  "tasks": [
    {
      "id": "ui-header",
      "cluster": "ui",
      "spec": "tasks/ui-header.md",
      "write_scope": ["src/ui/**"],
      "candidates": [
        {"model": "claude:high"},
        {"model": "codex:medium"},
        {"model": "devin:medium"}
      ],
      "deps": []
    },
    {
      "id": "copy-fix",
      "cluster": "text",
      "spec": "tasks/copy-fix.md",
      "write_scope": ["src/copy/**"],
      "candidates": [{"model": "codex:medium"}],
      "deps": []
    },
    {
      "id": "integ-ui",
      "role": "integrator",
      "topic": "ui",
      "adopts": "ui-header",
      "model": "claude:high",
      "deps": ["ui-header"]
    },
    {
      "id": "review-ui",
      "role": "reviewer",
      "target_branch": "integ/ui",
      "model": "codex:medium",
      "deps": ["integ-ui"]
    }
  ],
  "gates": {"adopt": "coordinator", "merge": "human"},
  "review_run": {"enabled": true, "model": "devin:medium"}
}
